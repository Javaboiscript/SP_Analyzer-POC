# SQL Server Configuration
SQL_SERVER=localhost
SQL_DATABASE=YourDatabaseName
SQL_USER=sa
SQL_PASSWORD=YourPasswordHere
SQL_PORT=1433
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_CERT=yes
SQL_TIMEOUT=30
SQL_SERVER_DATABASE_URL=

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Application Configuration
PORT=8000
# MAX_PROMPT_ROWS: 0 or empty for unlimited (no cap). Set a number (e.g. 500) to cap rows when desired.
MAX_PROMPT_ROWS=0
##0 to set to infinity